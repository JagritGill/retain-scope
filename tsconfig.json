{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": []
  },
  "include": ["src/**/*.ts"]
}
